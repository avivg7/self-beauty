# Absolute origin used for canonical URLs, Open Graph and the sitemap.
SITE=https://avivg7.github.io
# Path prefix. "/self-beauty" for the GitHub project page, "/" for a custom domain.
BASE=/self-beauty
# Set to 1 to include records marked demo:true in a production build (dev always includes them).
# SB_INCLUDE_DEMO=1
# Dev only (needs demo mode): truncate the puppies list to n items to review 1/2/3/6/10-listing layouts.
# SB_LISTING_LIMIT=2

# Supabase (public values, safe to bundle; security is RLS). Local stack: run `npx supabase status` for the values.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
