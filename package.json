{
  "name": "self-beauty",
  "version": "0.1.0",
  "private": true,
  "description": "Self Beauty — pedigree dog kennel and professional grooming, Bat Yam. Public website and owner admin.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "node scripts/serve-dist.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:demo --silent && playwright test",
    "test:a11y": "playwright test --project=a11y",
    "links": "node scripts/check-links.mjs",
    "media:ingest": "node scripts/media/ingest.mjs",
    "verify": "npm run lint && npm run check && npm run test:unit && npm run build && npm run links",
    "build:demo": "SB_INCLUDE_DEMO=1 astro build --outDir .demo-dist/ci"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "file-type": "^22.0.2",
    "globals": "^17.12.0",
    "heic-convert": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "libheif-js": "^1.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  }
}
