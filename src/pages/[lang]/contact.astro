---
import Base from '@/layouts/Base.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import { getDictionary, type Locale } from '@/i18n';
import { localePaths } from '@/lib/paths';
import {
  whatsappLink,
  telLink,
  phoneDisplay,
  phoneInternational,
  facebookUrl,
  type WaIntent,
} from '@/lib/contact';

export const getStaticPaths = localePaths;
const locale = Astro.params.lang as Locale;
const t = getDictionary(locale);
const intents: Record<string, WaIntent> = { puppy: 'general', litters: 'litters', grooming: 'grooming' };
---

<Base locale={locale} title={t.contact.title} description={t.contact.description} path="/contact/">
  <section class="section">
    <div class="container">
      <SectionHeading level={1} eyebrow={t.contact.eyebrow} title={t.contact.h1} lede={t.contact.lede} />
      <ul role="list" class="grid grid--2 ccards">
        <li class="ccard">
          <Icon name="whatsapp" class="ccard__icon" />
          <h2>{t.contact.whatsapp}</h2>
          <p class="ltr ccard__big">{phoneInternational}</p>
          <a class="btn btn--whatsapp" href={whatsappLink(locale)} target="_blank" rel="noopener"
            ><Icon name="whatsapp" /> {t.cta.whatsappUs}</a
          >
        </li>
        <li class="ccard">
          <Icon name="phone" class="ccard__icon" />
          <h2>{t.contact.phone}</h2>
          <p class="ltr ccard__big"><a href={telLink}>{phoneDisplay}</a></p>
          <a class="btn btn--secondary" href={telLink}><Icon name="phone" /> {t.cta.callFull}</a>
        </li>
        <li class="ccard">
          <Icon name="facebook" class="ccard__icon" />
          <h2>{t.contact.facebook}</h2>
          <p class="muted">Self Beauty</p>
          <a
            class="btn btn--secondary"
            href={facebookUrl}
            target="_blank"
            rel="noopener"
            aria-label={t.footer.facebookAria}
            ><Icon name="facebook" /> {t.cta.facebook} <Icon name="external" /></a
          >
        </li>
        <li class="ccard">
          <Icon name="pin" class="ccard__icon" />
          <h2>{t.contact.location}</h2>
          <p>{t.contact.locationText}</p>
          <p class="muted">{t.contact.languages}</p>
        </li>
      </ul>
      <p class="muted cnote">{t.contact.hoursNote}</p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <SectionHeading title={t.contact.quickTitle} />
      <ul role="list" class="grid grid--3 quick">
        {
          t.contact.quick.map((q) => (
            <li>
              <a
                class="quick__link"
                href={whatsappLink(locale, intents[q.key] ?? 'general')}
                target="_blank"
                rel="noopener"
              >
                <span class="quick__title">{q.title}</span>
                <span class="quick__text muted">{q.text}</span>
                <span class="quick__go">
                  <Icon name="whatsapp" /> WhatsApp
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
<style>
  .ccard {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    min-width: 0;
    overflow-wrap: anywhere;
    padding: var(--sp-5);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-surface);
    align-content: start;
  }
  .ccard__icon {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--c-gold-text);
  }
  .ccard h2 {
    font-size: var(--fs-lg);
  }
  .ccard__big {
    font-size: var(--fs-xl);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .ccard__big a {
    text-decoration: none;
  }
  .cnote {
    margin-top: var(--sp-4);
    font-size: var(--fs-sm);
  }
  .quick__link {
    display: grid;
    gap: 0.35rem;
    padding: var(--sp-5);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-surface);
    text-decoration: none;
    color: var(--c-text);
    min-height: 100%;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .quick__link:hover {
    border-color: var(--c-burgundy);
    box-shadow: var(--shadow-md);
  }
  .quick__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-xl);
  }
  .quick__text {
    font-size: var(--fs-sm);
  }
  .quick__go {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--c-whatsapp);
  }
  .quick__go svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
