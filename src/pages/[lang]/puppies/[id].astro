---
import Base from '@/layouts/Base.astro';
import Picture from '@/components/Picture.astro';
import VideoTile from '@/components/VideoTile.astro';
import StatusChip from '@/components/StatusChip.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { getImage as astroGetImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getDictionary, interpolate, localizedField, formatters, LOCALES, type Locale } from '@/i18n';
import { localeHref } from '@/lib/urls';
import { whatsappLink } from '@/lib/contact';
import { ageLabel } from '@/lib/age';
import { getPuppies } from '@/lib/listings';
import { getImage as getMedia } from '@/data/media';

export async function getStaticPaths() {
  const puppies = await getPuppies();
  return LOCALES.flatMap((lang) => puppies.map((p) => ({ params: { lang, id: p.id }, props: { puppy: p } })));
}
const locale = Astro.params.lang as Locale;
const { puppy } = Astro.props;
const t = getDictionary(locale);
const d = puppy.data;
const name = localizedField(d.name, locale);
const breed = t.breeds[d.breed].name;
const desc = localizedField(d.description, locale);
const pedigree = localizedField(d.pedigreeSummary, locale);
const age = d.birthDate ? ageLabel(locale, d.birthDate) : '';
const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/media/**/*.jpg', { eager: true });
const gallery = await Promise.all(
  d.images.map(async (img) => {
    const src = assets[`/src/assets/media/${img.media}.jpg`]?.default;
    if (!src) throw new Error(`Missing asset ${img.media}`);
    const lg = await astroGetImage({ src, width: Math.min(1800, src.width), format: 'webp', quality: 82 });
    return { ...img, lg, alt: localizedField(img.alt, locale) || getMedia(img.media).alt[locale] };
  }),
);
const title = `${name} · ${breed} · ${t.meta.siteName}`;
const description = desc.slice(0, 155);
const group = `puppy-${puppy.id}`;
const parents = [
  d.parents?.sire && { role: t.puppies.card.sire, ...d.parents.sire },
  d.parents?.dam && { role: t.puppies.card.dam, ...d.parents.dam },
].filter(Boolean) as { role: string; name: string; titles: string[]; verified: boolean }[];
---

<Base locale={locale} title={title} description={description} path={`/puppies/${puppy.id}/`} ogType="article">
  <article class="section pdetail">
    <div class="container">
      <p class="pdetail__back">
        <a href={localeHref(locale, 'puppies')}
          ><Icon name="arrow" class="pdetail__back-icon" /> {t.cta.backToPuppies}</a
        >
      </p>
      <div class="pdetail__grid">
        <div class="pdetail__gallery" aria-label={interpolate(t.puppies.detail.gallery, { name })}>
          <div class="frame pdetail__main">
            <button
              type="button"
              class="pdetail__mainbtn"
              data-lb-item
              data-lb-type="image"
              data-lb-group={group}
              data-lb-src={gallery[0]!.lg.src}
              data-lb-w={gallery[0]!.lg.attributes.width}
              data-lb-h={gallery[0]!.lg.attributes.height}
              data-lb-alt={gallery[0]!.alt}
              data-lb-caption={name}
              aria-label={t.gallery_ui.open.replace('{title}', name)}
            >
              <Picture
                id={gallery[0]!.media}
                locale={locale}
                alt={gallery[0]!.alt}
                sizes="(min-width: 64rem) 560px, 100vw"
                widths={[420, 640, 900, 1200]}
                loading="eager"
                fetchpriority="high"
                class="pdetail__img"
              />
            </button>
          </div>
          {
            gallery.length > 1 && (
              <ul role="list" class="pdetail__thumbs">
                {gallery.slice(1).map((g) => (
                  <li>
                    <button
                      type="button"
                      class="pdetail__thumb ratio ratio--1x1"
                      data-lb-item
                      data-lb-type="image"
                      data-lb-group={group}
                      data-lb-src={g.lg.src}
                      data-lb-w={g.lg.attributes.width}
                      data-lb-h={g.lg.attributes.height}
                      data-lb-alt={g.alt}
                      data-lb-caption={name}
                      aria-label={t.gallery_ui.open.replace('{title}', g.alt)}
                    >
                      <Picture id={g.media} locale={locale} alt="" sizes="200px" widths={[240, 420]} />
                    </button>
                  </li>
                ))}
              </ul>
            )
          }
          {
            d.video && (
              <div class="pdetail__video">
                <VideoTile id={d.video} locale={locale} group={group} />
              </div>
            )
          }
        </div>

        <div class="pdetail__info">
          <p class="cluster">
            <StatusChip status={d.status} locale={locale} />
            {d.demo && <span class="chip chip--demo chip--plain">{t.common.demoBadge}</span>}
            {
              d.showProspect && (
                <span class="rosette">
                  <Icon name="rosette" />
                  {t.puppies.card.showProspect}
                </span>
              )
            }
            {
              d.breedingProspect && (
                <span class="rosette">
                  <Icon name="rosette" />
                  {t.puppies.card.breedingProspect}
                </span>
              )
            }
          </p>
          <p class="eyebrow">{breed}</p>
          <h1>{name}</h1>
          <dl class="facts">
            <div><dt>{t.puppies.card.breed}</dt><dd>{breed}</dd></div>
            {
              d.sex !== 'mixed' && (
                <div>
                  <>
                    <dt>{t.puppies.card.sex}</dt>
                    <dd>{t.sex[d.sex]}</dd>
                  </>
                </div>
              )
            }
            {
              d.birthDate && (
                <div>
                  <>
                    <dt>{t.puppies.card.born}</dt>
                    <dd>
                      {formatters.date(locale, d.birthDate)}
                      {age ? ` (${age})` : ''}
                    </dd>
                  </>
                </div>
              )
            }
            <div><dt>{t.puppies.card.status}</dt><dd>{t.status[d.status]}</dd></div>
          </dl>
          <h2 class="pdetail__h">{t.puppies.detail.aboutTitle}</h2>
          <p>{desc}</p>
          {
            (pedigree || parents.length > 0) && (
              <>
                <h2 class="pdetail__h">{t.puppies.detail.pedigreeTitle}</h2>
                {pedigree && <p>{pedigree}</p>}
                {parents.length > 0 && (
                  <dl class="facts">
                    {parents.map((p) => (
                      <div>
                        <dt>{p.role}</dt>
                        <dd>
                          <span class="ltr">{p.name}</span>
                          {p.verified && p.titles.length > 0 && (
                            <span class="rosette">
                              <Icon name="rosette" />
                              {p.titles.join(' · ')}
                            </span>
                          )}
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
              </>
            )
          }
          <p class="muted pdetail__note">{t.puppies.noPriceNote}</p>
          {d.demo && <p class="pdetail__demo">{t.puppies.card.demoNote}</p>}
          <div class="pdetail__actions">
            <a
              class="btn btn--lg btn--whatsapp"
              href={whatsappLink(locale, 'puppy', { name, breed })}
              target="_blank"
              rel="noopener"><Icon name="whatsapp" /> {t.cta.talkAboutPuppy}</a
            >
          </div>
        </div>
      </div>
    </div>
  </article>

  <CtaBand
    locale={locale}
    title={interpolate(t.puppies.detail.ctaTitle, { name })}
    text={t.puppies.detail.ctaText}
    intent="puppy"
    values={{ name, breed }}
    waLabel={t.cta.talkAboutPuppy}
  />
</Base>

<style>
  .pdetail__back {
    margin-bottom: var(--sp-5);
    font-size: var(--fs-sm);
  }
  .pdetail__back a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    text-decoration: none;
    font-weight: 500;
  }
  .pdetail__back-icon {
    width: 1rem;
    height: 1rem;
    transform: scaleX(-1);
  }
  html[dir='rtl'] .pdetail__back-icon {
    transform: none;
  }
  .pdetail__grid {
    display: grid;
    gap: var(--sp-6);
  }
  @media (min-width: 64rem) {
    .pdetail__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--sp-8);
      align-items: start;
    }
  }
  .pdetail__gallery {
    display: grid;
    gap: var(--sp-4);
  }
  .pdetail__main {
    margin: var(--frame-offset);
  }
  .pdetail__mainbtn {
    display: block;
    width: 100%;
    border-radius: var(--r-sm);
    overflow: hidden;
  }
  .pdetail__img {
    aspect-ratio: 4 / 5;
    width: 100%;
    object-fit: cover;
  }
  .pdetail__thumbs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-3);
  }
  .pdetail__thumb {
    display: block;
    width: 100%;
    border-radius: var(--r-sm);
  }
  .pdetail__thumb :global(img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .pdetail__thumb:hover :global(img) {
    transform: scale(1.04);
  }
  .pdetail__video {
    max-width: 20rem;
  }
  .pdetail__info {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
  }
  .pdetail__info h1 {
    font-size: var(--fs-3xl);
  }
  .pdetail__h {
    font-size: var(--fs-lg);
    margin-top: var(--sp-3);
  }
  .facts {
    display: grid;
    gap: 0.4rem;
  }
  .facts div {
    display: grid;
    grid-template-columns: minmax(6rem, auto) 1fr;
    gap: 0.75rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--c-border);
  }
  .facts dt {
    color: var(--c-text-2);
    font-size: var(--fs-sm);
  }
  .facts dd {
    font-weight: 500;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pdetail__note {
    font-size: var(--fs-sm);
  }
  .pdetail__demo {
    padding: 0.6rem 0.9rem;
    border-radius: var(--r-sm);
    background: #ffe9a8;
    color: #5a4300;
    font-size: var(--fs-sm);
  }
  .pdetail__actions {
    margin-top: var(--sp-3);
  }
  @media (max-width: 30rem) {
    .pdetail__actions .btn {
      width: 100%;
    }
  }
</style>
