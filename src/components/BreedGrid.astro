---
import { getDictionary, type Locale } from '@/i18n';
import { site } from '@/data/site';
import Icon from './Icon.astro';
interface Props {
  locale: Locale;
  compact?: boolean;
}
const { locale, compact = false } = Astro.props;
const t = getDictionary(locale);
---

<ul role="list" class:list={['breeds', compact && 'breeds--compact']}>
  {
    site.breeds.map((b) => (
      <li class="breed">
        <span class="breed__mark" aria-hidden="true">
          <Icon name="paw" />
        </span>
        <h3 class="breed__name">{t.breeds[b].name}</h3>
        {!compact && <p class="breed__blurb">{t.breeds[b].blurb}</p>}
      </li>
    ))
  }
</ul>
<style>
  .breeds {
    display: grid;
    gap: var(--sp-3);
  }
  @media (min-width: 40rem) {
    .breeds {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .breeds {
      grid-template-columns: repeat(5, 1fr);
      gap: var(--sp-4);
    }
  }
  .breed {
    display: grid;
    gap: 0.5rem;
    padding: var(--sp-4);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-surface);
    align-content: start;
  }
  .breed__mark {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--c-gold-text);
    border: 1px solid var(--c-gold);
  }
  .breed__mark :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
  }
  .breed__name {
    font-size: var(--fs-lg);
  }
  .breed__blurb {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
  }
  .breeds--compact {
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 64rem) {
    .breeds--compact {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .breeds--compact .breed {
    padding: var(--sp-3);
    grid-template-columns: auto 1fr;
    align-items: center;
  }
  .breeds--compact .breed__name {
    font-size: var(--fs-base);
    font-family: var(--font-body);
    font-weight: 600;
  }
</style>
