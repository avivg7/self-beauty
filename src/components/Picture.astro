---
/**
 * Responsive picture from the media catalogue. AVIF + WebP + JPEG fallback, explicit widths and sizes,
 * intrinsic width/height for zero CLS, focal-point object-position so faces are never cropped away.
 */
import { Picture as AstroPicture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getImage as getMedia, type MediaImage } from '@/data/media';
import type { Locale } from '@/i18n';

interface Props {
  id: string;
  locale: Locale;
  sizes: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  /** Override alt (e.g. empty for decorative duplicates) */
  alt?: string;
  formats?: ('avif' | 'webp')[];
  /** 1–100; lower for large decorative backdrops under overlays */
  quality?: number;
}
const {
  id,
  locale,
  sizes,
  widths = [420, 640, 900, 1200, 1600],
  loading = 'lazy',
  fetchpriority,
  class: className,
  alt,
  formats = ['avif', 'webp'],
  quality,
} = Astro.props;

const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/media/**/*.{jpg,png}', {
  eager: true,
});
const item: MediaImage = getMedia(id);
const key = Object.keys(assets).find(
  (k) => k === `/src/assets/media/${id}.jpg` || k === `/src/assets/media/${id}.png`,
);
if (!key) throw new Error(`No asset file for media id "${id}"`);
const src = assets[key]!.default;
const usable = widths.filter((w) => w <= src.width);
if (!usable.includes(src.width) && usable.length < widths.length) usable.push(src.width);
const objectPosition = `${Math.round(item.focal.x * 100)}% ${Math.round(item.focal.y * 100)}%`;
---

<AstroPicture
  src={src}
  alt={alt ?? item.alt[locale]}
  widths={usable}
  sizes={sizes}
  formats={formats}
  fallbackFormat="jpg"
  {...quality !== undefined ? { quality } : {}}
  loading={loading}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  fetchpriority={fetchpriority}
  class={className}
  style={`object-position:${objectPosition}`}
  pictureAttributes={{ class: 'pic' }}
/>
<style is:global>
  .pic {
    display: contents;
  }
</style>
