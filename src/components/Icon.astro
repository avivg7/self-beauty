  facebook:
    '<path fill="currentColor" stroke="none" d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.4V14h2.8v8h3.3z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  'chevron-down': '<path d="M6 9l6 6 6-6"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  play: '<path fill="currentColor" stroke="none" d="M8 5.5v13a1 1 0 0 0 1.5.87l11-6.5a1 1 0 0 0 0-1.74l-11-6.5A1 1 0 0 0 8 5.5z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  accessibility:
    '<circle cx="12" cy="4.5" r="1.75" fill="currentColor" stroke="none"/><path d="M4 8.5l6 1v4l-2.5 7M20 8.5l-6 1v4l2.5 7M10 13.5h4"/>',
  rosette: '<circle cx="12" cy="9" r="5.5"/><path d="M8.5 13.5L7 21l5-2.5 5 2.5-1.5-7.5"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  volume: '<path d="M4 9.5v5h3.5L12 18V6L7.5 9.5H4zM15.5 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"/>',
  'volume-off': '<path d="M4 9.5v5h3.5L12 18V6L7.5 9.5H4zM16 9.5l5 5M21 9.5l-5 5"/>',
  photo:
    '<rect x="3.5" y="5" width="17" height="14" rx="2"/><circle cx="9" cy="10" r="1.75"/><path d="M20 16l-4.5-4.5L8 19"/>',
  video: '<rect x="3" y="6" width="13" height="12" rx="2"/><path d="M16 10l5-2.5v9L16 14"/>',
  pin: '<path d="M12 21s-6.5-5.5-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.5 12 21 12 21z"/><circle cx="12" cy="10" r="2.25"/>',
  paw: '<circle cx="7" cy="9" r="1.75"/><circle cx="17" cy="9" r="1.75"/><circle cx="10" cy="5.5" r="1.75"/><circle cx="14" cy="5.5" r="1.75"/><path d="M12 11c-3 0-5.5 2.5-5.5 4.8 0 1.5 1 2.7 2.4 2.7 1.1 0 1.7-.6 3.1-.6s2 .6 3.1.6c1.4 0 2.4-1.2 2.4-2.7C17.5 13.5 15 11 12 11z"/>',
