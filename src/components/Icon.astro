---
/** Single consistent icon family (1.75 stroke, rounded joins). Decorative by default; pass a `title` to make it meaningful. */
export type IconName =
  | 'phone'
  | 'whatsapp'
  | 'facebook'
  | 'menu'
  | 'close'
  | 'chevron-down'
  | 'arrow'
  | 'play'
  | 'globe'
  | 'accessibility'
  | 'rosette'
  | 'check'
  | 'volume'
  | 'volume-off'
  | 'photo'
  | 'video'
  | 'pin'
  | 'paw'
  | 'external'
  | 'crown';
interface Props {
  name: IconName;
  class?: string;
  title?: string;
  size?: number;
}
const { name, class: className, title, size } = Astro.props;
const paths: Record<IconName, string> = {
  phone:
    '<path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z"/>',
