---
import { getDictionary, localizedField, type Locale } from '@/i18n';
import { localeHref } from '@/lib/urls';
import { whatsappLink } from '@/lib/contact';
import { ageLabel } from '@/lib/age';
import type { Puppy } from '@/lib/listings';
import Picture from './Picture.astro';
import StatusChip from './StatusChip.astro';
import Icon from './Icon.astro';

interface Props {
  puppy: Puppy;
  locale: Locale;
  eager?: boolean;
}
const { puppy, locale, eager = false } = Astro.props;
const t = getDictionary(locale);
const d = puppy.data;
const name = localizedField(d.name, locale);
const breed = t.breeds[d.breed].name;
const cover = d.images[0]!;
const url = localeHref(locale, `puppies/${puppy.id}`);
const age = d.birthDate ? ageLabel(locale, d.birthDate) : '';
const titleId = `puppy-${puppy.id}-title`;
---

<article class="card pcard" aria-labelledby={titleId}>
  <a class="pcard__media card__media ratio ratio--4x5" href={url} tabindex="-1" aria-hidden="true">
    <Picture
      id={cover.media}
      locale={locale}
      alt=""
      sizes="(min-width: 64rem) 360px, (min-width: 40rem) 50vw, 100vw"
      widths={[420, 640, 900]}
      loading={eager ? 'eager' : 'lazy'}
    />
    <span class="pcard__chips">
      <StatusChip status={d.status} locale={locale} />
      {d.demo && <span class="chip chip--demo chip--plain">{t.common.demoBadge}</span>}
    </span>
  </a>
  <div class="card__body pcard__body">
    <p class="pcard__breed">{breed}</p>
    <h3 class="pcard__title" id={titleId}><a href={url}>{name}</a></h3>
    <dl class="pcard__facts">
      {
        d.sex !== 'mixed' && (
          <div>
            <>
              <dt>{t.puppies.card.sex}</dt>
              <dd>{t.sex[d.sex]}</dd>
            </>
          </div>
        )
      }
      {
        age && (
          <div>
            <>
              <dt>{t.puppies.card.age}</dt>
              <dd>{age}</dd>
            </>
          </div>
        )
      }
      {
        d.showProspect && (
          <div class="pcard__flag">
            <>
              <dt class="sr-only">{t.puppies.card.showProspect}</dt>
              <dd>
                <Icon name="rosette" /> {t.puppies.card.showProspect}
              </dd>
            </>
          </div>
        )
      }
    </dl>
    <p class="pcard__desc">{localizedField(d.description, locale)}</p>
    <div class="pcard__actions">
      <a
        class="btn btn--whatsapp"
        href={whatsappLink(locale, 'puppy', { name, breed })}
        target="_blank"
        rel="noopener"><Icon name="whatsapp" /> {t.cta.talkAboutPuppy}</a
      >
      <a class="btn btn--ghost" href={url}>{t.cta.details} <Icon name="arrow" class="rtl-flip" /></a>
    </div>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
  }
  .pcard__media {
    display: block;
  }
  .pcard__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pcard__chips {
    position: absolute;
    top: 0.75rem;
    inset-inline-start: 0.75rem;
    display: flex;
    gap: 0.4rem;
    z-index: 1;
  }
  .pcard__body {
    display: grid;
    gap: 0.6rem;
    flex: 1;
    align-content: start;
  }
  .pcard__breed {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-gold-text);
  }
  .pcard__title {
    font-size: var(--fs-xl);
  }
  .pcard__title a {
    color: inherit;
    text-decoration: none;
  }
  .pcard__title a:hover {
    color: var(--c-burgundy);
  }
  .pcard__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: var(--fs-sm);
  }
  .pcard__facts div {
    display: flex;
    gap: 0.35rem;
  }
  .pcard__facts dt {
    color: var(--c-text-2);
  }
  .pcard__facts dt::after {
    content: ':';
  }
  .pcard__facts dd {
    font-weight: 500;
  }
  .pcard__flag dd {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--c-gold-text);
  }
  .pcard__flag :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .pcard__desc {
    color: var(--c-text-2);
    font-size: var(--fs-sm);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pcard__actions {
    display: grid;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  @media (min-width: 26rem) {
    .pcard__actions {
      grid-template-columns: auto auto;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
<style is:global>
  html[dir='rtl'] .rtl-flip {
    transform: scaleX(-1);
  }
</style>
