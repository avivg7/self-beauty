---
/**
 * Uniform photo/video grid (4:5 tiles, landscape items span two columns) with an accessible lightbox
 * and optional type/breed filters. Tiles have fixed aspect ratios, so nothing shifts on load.
 */
import { getImage as astroGetImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getDictionary, type Locale } from '@/i18n';
import type { MediaItem, Breed } from '@/data/media';
import Picture from './Picture.astro';
import VideoTile from './VideoTile.astro';
import Icon from './Icon.astro';

interface Props {
  items: MediaItem[];
  locale: Locale;
  group: string;
  filters?: boolean;
  breedFilter?: boolean;
  columns?: 2 | 3 | 4;
  class?: string;
}
const {
  items,
  locale,
  group,
  filters = false,
  breedFilter = false,
  columns = 3,
  class: className,
} = Astro.props;
const t = getDictionary(locale);
const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/media/**/*.{jpg,png}', {
  eager: true,
});

async function large(id: string) {
  const key = `/src/assets/media/${id}.jpg`;
  const src = assets[key]?.default;
  if (!src) throw new Error(`No asset for ${id}`);
  const w = Math.min(1800, src.width);
  const img = await astroGetImage({ src, width: w, format: 'webp', quality: 82 });
  return { src: img.src, w: img.attributes.width as number, h: img.attributes.height as number };
}
const prepared = await Promise.all(
  items.map(async (m) => {
    if (m.kind === 'image') {
      const lg = await large(m.id);
      return { m, lg, wide: lg.w / lg.h > 1.15, full: false };
    }
    return { m, lg: null, wide: m.orientation === 'landscape', full: false };
  }),
);
// In a 3-column grid every wide tile (2 cols) pairs with one portrait tile (1 col). When wide tiles
// outnumber portrait ones, the surplus would leave an empty column, so those are promoted to full rows
// (16:9). Only the genuinely wide images are eligible (a 16:9 crop of a near-square photo would cut faces),
// and the picks are spread evenly through the sequence.
{
  const ratio = (p: (typeof prepared)[number]) =>
    p.m.kind === 'image' && p.lg
      ? p.lg.w / p.lg.h
      : p.m.kind === 'video' && p.m.orientation === 'landscape'
        ? 16 / 9
        : 0;
  const wideIdx = prepared.map((p, i) => (p.wide ? i : -1)).filter((i) => i >= 0);
  const portrait = prepared.length - wideIdx.length;
  const surplus = Math.max(0, wideIdx.length - portrait);
  if (surplus > 0) {
    const eligible = wideIdx.filter((i) => ratio(prepared[i]!) >= 1.45);
    const pool = eligible.length >= surplus ? eligible : wideIdx;
    const step = pool.length / surplus;
    for (let k = 0; k < surplus; k++) prepared[pool[Math.floor(k * step)]!]!.full = true;
  }
}
const breeds = Array.from(new Set(items.flatMap((m) => m.breeds ?? []))) as Breed[];
const hasVideos = items.some((m) => m.kind === 'video');
const uid = `g-${group}`;
---

<div class:list={['gallery', className]} data-gallery={group}>
  {
    filters && (
      <div class="gallery__filters" role="group" aria-label={t.shows.filters.all}>
        <div
          class="gallery__seg"
          role="radiogroup"
          aria-label={`${t.gallery_ui.photo} / ${t.gallery_ui.video}`}
        >
          <label>
            <>
              <input type="radio" name={`${uid}-type`} value="all" checked data-filter="type" />
              <span>{t.shows.filters.all}</span>
            </>
          </label>
          <label>
            <>
              <input type="radio" name={`${uid}-type`} value="image" data-filter="type" />
              <span>{t.shows.filters.photos}</span>
            </>
          </label>
          {hasVideos && (
            <label>
              <input type="radio" name={`${uid}-type`} value="video" data-filter="type" />
              <span>{t.shows.filters.videos}</span>
            </label>
          )}
        </div>
        {breedFilter && breeds.length > 1 && (
          <label class="gallery__breed">
            <span class="sr-only">{t.shows.filters.breed}</span>
            <select class="select" data-filter="breed" aria-label={t.shows.filters.breed}>
              <option value="all">{t.puppies.filters.all}</option>
              {breeds.map((b) => (
                <option value={b}>{t.breeds[b].short}</option>
              ))}
            </select>
          </label>
        )}
        <p class="gallery__count muted" data-gallery-count aria-live="polite" />
      </div>
    )
  }
  <ul role="list" class={`gallery__grid gallery__grid--${columns}`}>
    {
      prepared.map(({ m, lg, wide, full }) => (
        <li
          class:list={['gallery__item', wide && 'gallery__item--wide', full && 'gallery__item--full']}
          data-type={m.kind}
          data-breeds={(m.breeds ?? []).join(' ')}
          data-chapter={m.chapter ?? ''}
        >
          {m.kind === 'image' && lg ? (
            <figure class="gtile">
              <button
                type="button"
                class="gtile__btn"
                data-lb-item
                data-lb-type="image"
                data-lb-group={group}
                data-lb-src={lg.src}
                data-lb-w={lg.w}
                data-lb-h={lg.h}
                data-lb-alt={m.alt[locale]}
                data-lb-caption={m.caption?.[locale] ?? ''}
                aria-label={t.gallery_ui.open.replace('{title}', m.caption?.[locale] ?? m.alt[locale])}
              >
                <Picture
                  id={m.id}
                  locale={locale}
                  sizes={
                    full
                      ? '(min-width: 64rem) 1152px, 100vw'
                      : wide
                        ? `(min-width: 64rem) ${Math.round((1152 / columns) * 2)}px, (min-width: 40rem) 66vw, 100vw`
                        : `(min-width: 64rem) ${Math.round(1152 / columns)}px, (min-width: 40rem) 33vw, 50vw`
                  }
                  widths={full ? [640, 1000, 1400] : wide ? [480, 768, 1000] : [300, 480, 640]}
                  class="gtile__img"
                />
                <span class="gtile__zoom" aria-hidden="true">
                  <Icon name="photo" />
                </span>
              </button>
              {m.caption && (
                <figcaption class="gtile__cap">
                  {m.caption[locale]}
                  {m.year ? <span class="num muted"> · {m.year}</span> : null}
                </figcaption>
              )}
            </figure>
          ) : (
            <VideoTile id={m.id} locale={locale} group={group} />
          )}
        </li>
      ))
    }
  </ul>
  <p class="gallery__empty muted" data-gallery-empty hidden>{t.puppies.filters.none}</p>
</div>
{filters && <script>import '@/scripts/filters';</script>}

<style>
  .gallery {
    display: grid;
    gap: var(--sp-5);
  }
  .gallery__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }
  .gallery__seg {
    display: inline-flex;
    border: 1px solid var(--c-border-strong);
    border-radius: var(--r-pill);
    padding: 0.2rem;
    background: var(--c-surface);
  }
  .gallery__seg label {
    position: relative;
  }
  .gallery__seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .gallery__seg span {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.25rem 1rem;
    border-radius: var(--r-pill);
    font-weight: 500;
    font-size: var(--fs-sm);
  }
  .gallery__seg input:checked + span {
    background: var(--c-charcoal);
    color: var(--c-text-on-dark);
  }
  .gallery__seg input:focus-visible + span {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }
  .gallery__breed .select {
    min-height: 2.9rem;
    width: auto;
    border-radius: var(--r-pill);
    padding-inline: 1rem;
  }
  .gallery__count {
    font-size: var(--fs-sm);
    margin-inline-start: auto;
  }
  /* Uniform portrait tiles (4:5); landscape photos and videos span two columns (dense packing keeps rows full). */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: var(--sp-3);
  }
  @media (min-width: 40rem) {
    .gallery__grid {
      gap: var(--sp-4);
    }
    .gallery__grid--3,
    .gallery__grid--4 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .gallery__grid--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .gallery__item {
    min-width: 0;
    display: grid;
  }
  .gallery__item--wide {
    grid-column: span 2;
  }
  .gallery__item--full {
    grid-column: 1 / -1;
  }
  .gtile {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.5rem;
  }
  .gtile__btn {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--r-sm);
    background: var(--c-cream);
  }
  .gallery__item--wide .gtile__btn {
    aspect-ratio: auto;
    height: 100%;
    min-height: 12rem;
  }
  /* Declared after the wide rule so full rows win the cascade (a full tile is also wide) */
  .gallery__item--full .gtile__btn {
    aspect-ratio: 16 / 9;
    height: auto;
  }
  .gtile__btn :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .gtile__btn:hover :global(img) {
    transform: scale(1.03);
  }
  .gtile__zoom {
    position: absolute;
    inset-inline-end: 0.5rem;
    top: 0.5rem;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgb(12 9 9 / 55%);
    color: #fff;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .gtile__zoom :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .gtile__btn:hover .gtile__zoom,
  .gtile__btn:focus-visible .gtile__zoom {
    opacity: 1;
  }
  .gtile__cap {
    font-size: var(--fs-sm);
    color: var(--c-text-2);
  }
</style>
